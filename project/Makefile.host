TARGET := serial_frame_decode
SCREENLOG := screenlog.0
OUT ?= decoded_frames
PYTHON ?= python3

CC ?= cc
CPPFLAGS ?= -Iinclude
CFLAGS ?= -O2 -Wall -Wextra -std=c11

.PHONY: all decode plot clean

all: $(TARGET)

$(TARGET): tools/serial_frame_decode.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ $<

decode: $(TARGET)
	./$(TARGET) $(SCREENLOG) $(OUT)

plot:
	$(PYTHON) tools/live_xyz_plot.py

clean:
	rm -f $(TARGET)
