TARGET := serial_frame_decode
LOG ?= screenlog.0
OUT ?= decoded_frames

CC ?= cc
CPPFLAGS ?= -Iinclude
CFLAGS ?= -O2 -Wall -Wextra -std=c11

.PHONY: all decode clean

all: $(TARGET)

$(TARGET): tools/serial_frame_decode.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ $<

decode: $(TARGET)
	./$(TARGET) $(LOG) $(OUT)

clean:
	rm -f $(TARGET)
